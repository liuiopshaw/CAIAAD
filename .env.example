# Hosted LLM API Configuration (OpenAI-compatible)
## Endpoint URL of your OpenAI-compatible API (fill in per your provider and region)
QWEN_API_BASE=https://your-endpoint/compatible-mode/v1
QWEN_API_KEY=YOUR_API_KEY
## Hosted model name (used by scripts/llm_endpoints.json via model_env routing
## for externally-routed agents, e.g. coordinator / extractor)
QWEN_MODEL_NAME=your-model-name

# OpenAI-Compatible Configuration (Required by CrewAI)
## CrewAI/LiteLLM accesses via OpenAI-compatible interface; can match QWEN_API_*
OPENAI_API_BASE=https://your-endpoint/v1
OPENAI_API_KEY=YOUR_API_KEY

# Materials Project API Configuration (Optional)
MATERIALS_PROJECT_API_KEY=YOUR_MATERIALS_PROJECT_API_KEY

# PubChem API Configuration (Optional)
PUBCHEM_API_KEY=YOUR_PUBCHEM_API_KEY

# NCBI E-utilities Configuration (Optional, raises PubMed rate limit from 3 to 10 req/s)
NCBI_API_KEY=YOUR_NCBI_API_KEY
NCBI_EMAIL=your-email@example.com

# DrugBank API Configuration (Optional)
DRUGBANK_API_KEY=YOUR_DRUGBANK_API_KEY

# MolPort API Configuration (Optional, for commercial availability queries)
MOLPORT_API_KEY=YOUR_MOLPORT_API_KEY

# Model Parameter Configuration
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=8196

# Temperature Configuration for Specific Agents
# Designer Agent Uses Higher Temperature to Increase Diversity
DESIGNER_TEMPERATURE=0.8

# Assessment Experts Use Lower Temperature to Ensure Accuracy

# Overall Assessment Expert Uses Moderate Temperature

# Other Experts Use Default Evaluation Temperature
MECHANISM_TEMPERATURE=0.3
EXTRACTOR_TEMPERATURE=0.3

# CAIAAD Evaluation Scoring Agents
DELIVERY_TEMPERATURE=0.3
SAFETY_TEMPERATURE=0.3
MANUFACTURING_TEMPERATURE=0.3
RANKER_TEMPERATURE=0.1

# Language Configuration
# Available options: zh (Chinese), en (English)
LANGUAGE=en

# Other Configuration
VERBOSE=True

# Tool Calling Configuration
# Enable tool calling for best performance
ENABLE_TOOLS=true
