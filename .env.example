# Hosted LLM API Configuration (OpenAI-compatible)
## Endpoint URL of your OpenAI-compatible API (fill in per your provider and region)
QWEN_API_BASE=https://your-endpoint/compatible-mode/v1
QWEN_API_KEY=YOUR_API_KEY
## Hosted model name (used by scripts/llm_endpoints.json via model_env routing
## for externally-routed agents, e.g. coordinator / extractor)
QWEN_MODEL_NAME=your-model-name

# Materials Project API Configuration (Optional)
MATERIALS_PROJECT_API_KEY=YOUR_MATERIALS_PROJECT_API_KEY

# PubChem API Configuration (Optional)
PUBCHEM_API_KEY=YOUR_PUBCHEM_API_KEY

# MolPort API Configuration (Optional, for commercial availability queries)
MOLPORT_API_KEY=YOUR_MOLPORT_API_KEY

# DrugBank API Configuration (Optional)
DRUGBANK_API_KEY=YOUR_DRUGBANK_API_KEY
